generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ContactMessageStatus {
  NEW
  READ
  ARCHIVED
}

model AdminUser {
  id                  String         @id @default(uuid()) @db.Uuid
  email               String         @unique @db.VarChar(320)
  passwordHash        String         @db.VarChar(255)
  name                String         @db.VarChar(120)
  role                AdminRole      @default(ADMIN)
  isActive            Boolean        @default(true)
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?      @db.Timestamptz(3)
  sessions            AdminSession[]
  auditLogs           AuditLog[]
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(3)

  @@index([isActive, role])
}

model AdminSession {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique @db.VarChar(64)
  userId     String    @db.Uuid
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime  @db.Timestamptz(3)
  lastUsedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Department {
  id           String           @id @default(uuid()) @db.Uuid
  slug         String           @unique @db.VarChar(80)
  name         String           @unique @db.VarChar(120)
  description  String?          @db.VarChar(1000)
  isActive     Boolean          @default(true)
  sortOrder    Int              @default(0)
  doctors      Doctor[]
  services     Service[]
  appointments Appointment[]
  messages     ContactMessage[]
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)

  @@index([isActive, sortOrder])
}

model Doctor {
  id             String        @id @default(uuid()) @db.Uuid
  name           String        @db.VarChar(160)
  qualifications String        @db.VarChar(255)
  specialty      String        @db.VarChar(160)
  bio            String?       @db.VarChar(3000)
  imageUrl       String?       @db.VarChar(2048)
  isActive       Boolean       @default(true)
  sortOrder      Int           @default(0)
  departmentId   String        @db.Uuid
  department     Department    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  appointments   Appointment[]
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  @@unique([name, departmentId])
  @@index([departmentId, isActive, sortOrder])
}

model Service {
  id           String     @id @default(uuid()) @db.Uuid
  title        String     @db.VarChar(160)
  description  String     @db.VarChar(3000)
  imageUrl     String?    @db.VarChar(2048)
  isActive     Boolean    @default(true)
  sortOrder    Int        @default(0)
  departmentId String     @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  @@unique([title, departmentId])
  @@index([departmentId, isActive, sortOrder])
}

model Appointment {
  id                 String            @id @default(uuid()) @db.Uuid
  reference          String            @unique @db.VarChar(48)
  patientName        String            @db.VarChar(160)
  parentGuardianName String?           @db.VarChar(160)
  phone              String            @db.VarChar(32)
  email              String?           @db.VarChar(320)
  patientAge         Int?
  departmentId       String            @db.Uuid
  department         Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  doctorId           String?           @db.Uuid
  doctor             Doctor?           @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  preferredDate      DateTime          @db.Date
  preferredTime      String            @db.VarChar(5)
  message            String?           @db.VarChar(1000)
  privacyConsent     Boolean           @default(false)
  status             AppointmentStatus @default(PENDING)
  activeSlotKey      String?           @unique @db.VarChar(64)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)

  @@index([status, preferredDate, preferredTime])
  @@index([departmentId, preferredDate])
  @@index([phone, createdAt])
}

model PublicSubmissionRateLimit {
  key       String   @id @db.VarChar(64)
  attempts  Int      @default(0)
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

model ContactMessage {
  id           String               @id @default(uuid()) @db.Uuid
  name         String               @db.VarChar(160)
  phone        String               @db.VarChar(32)
  email        String?              @db.VarChar(320)
  departmentId String?              @db.Uuid
  department   Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  message      String               @db.VarChar(3000)
  status       ContactMessageStatus @default(NEW)
  duplicateKey String?              @unique @db.VarChar(64)
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
}

model GalleryImage {
  id        String   @id @default(uuid()) @db.Uuid
  url       String   @unique @db.VarChar(2048)
  category  String   @default("General") @db.VarChar(80)
  altText   String   @db.VarChar(300)
  caption   String?  @db.VarChar(300)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([isActive, sortOrder])
}

model BlogPost {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique @db.VarChar(180)
  title       String    @db.VarChar(220)
  excerpt     String    @db.VarChar(500)
  content     String    @db.Text
  coverImage  String?   @db.VarChar(2048)
  isPublished Boolean   @default(false)
  publishedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@index([isPublished, publishedAt])
}

model WebsiteSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(120)
  value     Json     @db.JsonB
  isPublic  Boolean  @default(false)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model AuditLog {
  id         String     @id @default(uuid()) @db.Uuid
  actorId    String?    @db.Uuid
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String     @db.VarChar(80)
  resource   String     @db.VarChar(80)
  resourceId String?    @db.VarChar(64)
  metadata   Json?      @db.JsonB
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([resource, resourceId, createdAt])
}
