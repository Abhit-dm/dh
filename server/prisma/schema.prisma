generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ContactMessageStatus {
  NEW
  READ
  ARCHIVED
}

model AdminUser {
  id                  String         @id @default(uuid())
  email               String         @unique
  passwordHash        String
  name                String
  role                AdminRole      @default(ADMIN)
  isActive            Boolean        @default(true)
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?
  sessions            AdminSession[]
  auditLogs           AuditLog[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([isActive, role])
}

model AdminSession {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Department {
  id           String           @id @default(uuid())
  slug         String           @unique
  name         String           @unique
  description  String?
  isActive     Boolean          @default(true)
  sortOrder    Int              @default(0)
  doctors      Doctor[]
  services     Service[]
  appointments Appointment[]
  messages     ContactMessage[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([isActive, sortOrder])
}

model Doctor {
  id             String        @id @default(uuid())
  name           String
  qualifications String
  specialty      String
  bio            String?
  imageUrl       String?
  isActive       Boolean       @default(true)
  sortOrder      Int           @default(0)
  departmentId   String
  department     Department    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  appointments   Appointment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([name, departmentId])
  @@index([departmentId, isActive, sortOrder])
}

model Service {
  id           String     @id @default(uuid())
  title        String
  description  String
  imageUrl     String?
  isActive     Boolean    @default(true)
  sortOrder    Int        @default(0)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([title, departmentId])
  @@index([departmentId, isActive, sortOrder])
}

model Appointment {
  id                 String            @id @default(uuid())
  reference          String            @unique
  patientName        String
  parentGuardianName String?
  phone              String
  email              String?
  patientAge         Int?
  departmentId       String
  department         Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  doctorId           String?
  doctor             Doctor?           @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  preferredDate      DateTime
  preferredTime      String
  message            String?
  privacyConsent     Boolean           @default(false)
  status             AppointmentStatus @default(PENDING)
  activeSlotKey      String?           @unique
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([status, preferredDate, preferredTime])
  @@index([departmentId, preferredDate])
  @@index([phone, createdAt])
}

model PublicSubmissionRateLimit {
  key       String   @id
  attempts  Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

model ContactMessage {
  id           String               @id @default(uuid())
  name         String
  phone        String
  email        String?
  departmentId String?
  department   Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  message      String
  status       ContactMessageStatus @default(NEW)
  duplicateKey String?              @unique
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([status, createdAt])
}

model GalleryImage {
  id        String   @id @default(uuid())
  url       String   @unique
  category  String   @default("General")
  altText   String
  caption   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model BlogPost {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  excerpt     String
  content     String
  coverImage  String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, publishedAt])
}

model WebsiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  isPublic  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String     @id @default(uuid())
  actorId    String?
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  createdAt  DateTime   @default(now())

  @@index([actorId, createdAt])
  @@index([resource, resourceId, createdAt])
}
